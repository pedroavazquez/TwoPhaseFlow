#!/bin/sh
#------------------------------------------------------------------------------
# Static drop benchmark for gfmInterFlow (3D sphere, R = 0.25, sigma = 1,
# rho1/rho2 = 1000/1, mu1/mu2 = 10/0.1, unit cube, g = 0).
#
#   curvature model x force discretisation x mesh resolution
#   {constantCurvature, gradAlpha, RDF, heightFunction} x {CSF, GFM} x RES
#
# Base case: <TwoPhaseFlow>/run/velocityStaticCircle
# constantCurvature uses curv = 2/R = 8 (exact): velocities must stay at
# round-off level for both CSF and GFM (balanced-force check).
#
# Metrics written every time step (function objects in system/dropFunctions):
#   minMax : fieldMinMax of U and p                     -> max|U|(t)
#   pCore  : volume average of p in cellZone 'core'      (r < R - 3 dx)
#   pFar   : volume average of p in cellZone 'far'       (r > R + 3 dx)
#   Dp = <p>_core - <p>_far, free of the O(dx/R) bias of alpha-weighted
#   averages, since the interface band is excluded (the drop is static, so
#   the zones are fixed; created with topoSet after blockMesh).
# collect.py turns them into tables, convergence orders and plots.
#
# Requires TwoPhaseFlow built with tpf_vof_rename.sh (no symbol clash with
# ESI's libgeometricVoF), so function objects can run inside the solver.
#
# Usage:
#   ./Allrun [model ...]
# Environment (defaults in brackets):
#   RES       mesh cells per direction, list allowed     ["40"]
#   ENDTIME   end time [s]                               [0.02]
#   DT        fixed time step [s]                        [1e-4]
#   NWRITE    number of field writes per run             [4]
#   NPROCS    MPI ranks per run (1 = serial)             [1]
#   TIMEOUT   wall-clock limit per run [s]               [7200]
#
# Examples:
#   ./Allrun constantCurvature
#   RES="20 40 80" NPROCS=8 ./Allrun RDF heightFunction
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

base=../../../../run/velocityStaticCircle

res_list=${RES:-40}
endTime=${ENDTIME:-0.02}
deltaT=${DT:-1e-4}
nWrite=${NWRITE:-4}
nProcs=${NPROCS:-1}
tmax=${TIMEOUT:-7200}

if [ ! -d "$base/0.orig" ]
then
    echo "Error: base case (with 0.orig) not found: $base" 1>&2
    exit 1
fi

models=${*:-"constantCurvature gradAlpha RDF heightFunction"}

writeInterval=$(awk -v t="$endTime" -v n="$nWrite" 'BEGIN { printf "%.10g", t/n }')

# Split n into three factors as equal as possible (for 'simple' decomposition)
factor3()
{
    awk -v n="$1" 'BEGIN {
        best = -1
        for (a = 1; a <= n; a++) if (n % a == 0)
            for (b = 1; b <= n/a; b++) if ((n/a) % b == 0) {
                c = n/a/b
                mx = a; if (b > mx) mx = b; if (c > mx) mx = c
                mn = a; if (b < mn) mn = b; if (c < mn) mn = c
                if (best < 0 || mx - mn < best) { best = mx - mn; s = a " " b " " c }
            }
        print s
    }'
}

echo "Static drop matrix: models [$models], RES [$res_list], endTime $endTime," \
     "deltaT $deltaT, NPROCS $nProcs"

for res in $res_list
do
for model in $models
do
    for gfm in off on
    do
        case=case_${model}_GFM-${gfm}_N${res}
        echo "=== $case"
        rm -rf "$case"
        mkdir "$case"

        # Case set-up only, never results
        cp -r "$base"/0.orig "$base"/constant "$base"/system "$case"/
        rm -rf "$case"/constant/polyMesh

        # Mesh resolution
        sed -i -E "s/\([0-9]+ [0-9]+ [0-9]+\) simpleGrading/($res $res $res) simpleGrading/" \
            "$case"/system/blockMeshDict

        # Zones for the pressure jump: drop core and far field, 3 cells away
        # from the interface (sphere R = 0.25 centred at (0.5 0.5 0.5), as in
        # system/initAlphaFieldDict of the base case)
        rIn=$(awk -v n="$res" 'BEGIN { printf "%.10g", 0.25 - 3.0/n }')
        rOut=$(awk -v n="$res" 'BEGIN { printf "%.10g", 0.25 + 3.0/n }')
        cat > "$case"/system/topoSetDict <<TOPOSET
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    { name core; type cellSet; action new; source sphereToCell;
      origin (0.5 0.5 0.5); radius $rIn; }
    { name core; type cellZoneSet; action new; source setToCellZone;
      set core; }

    { name far; type cellSet; action new; source sphereToCell;
      origin (0.5 0.5 0.5); radius $rOut; }
    { name far; type cellSet; action invert; }
    { name far; type cellZoneSet; action new; source setToCellZone;
      set far; }
);
TOPOSET

        # Solver, models, controls
        cd_=$case/system/controlDict
        foamDictionary "$cd_" -entry application    -set gfmInterFlow > /dev/null
        foamDictionary "$cd_" -entry endTime        -set "$endTime"   > /dev/null
        foamDictionary "$cd_" -entry deltaT         -set "$deltaT"    > /dev/null
        foamDictionary "$cd_" -entry adjustTimeStep -set no           > /dev/null
        foamDictionary "$cd_" -entry writeControl   -set runTime      > /dev/null
        foamDictionary "$cd_" -entry writeInterval  -set "$writeInterval" > /dev/null
        foamDictionary "$cd_" -entry writeFormat    -set binary       > /dev/null
        foamDictionary "$cd_" -entry functions      -remove > /dev/null 2>&1

        cat >> "$cd_" <<'FUNCS'

functions
{
    #include "dropFunctions"
}
FUNCS

        cat > "$case"/system/dropFunctions <<'DROPFUNCS'
// Static-drop metrics, evaluated every time step

minMax
{
    type            fieldMinMax;
    libs            (fieldFunctionObjects);
    fields          (U p);
    location        no;
    mode            magnitude;
    writeControl    timeStep;
    writeInterval   1;
}

// Pressure inside the drop, away from the interface band
pCore
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    name            core;
    operation       volAverage;
    fields          (p);
    writeFields     false;
    log             false;
    writeControl    timeStep;
    writeInterval   1;
}

// Pressure outside the drop, away from the interface band
pFar
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    name            far;
    operation       volAverage;
    fields          (p);
    writeFields     false;
    log             false;
    writeControl    timeStep;
    writeInterval   1;
}
DROPFUNCS

        foamDictionary "$case"/constant/transportProperties \
            -entry surfaceForces/surfaceTensionForceModel -set "$model" > /dev/null
        foamDictionary "$case"/constant/transportProperties \
            -entry surfaceForces/curv -set 8 > /dev/null
        foamDictionary "$case"/system/fvSolution \
            -entry PIMPLE/ghostFluid -add "$gfm" > /dev/null

        if [ "$nProcs" -gt 1 ]
        then
            dp_=$case/system/decomposeParDict
            foamDictionary "$dp_" -entry numberOfSubdomains -set "$nProcs" > /dev/null
            foamDictionary "$dp_" -entry method -set simple > /dev/null
            foamDictionary "$dp_" -entry simpleCoeffs/n \
                -set "($(factor3 "$nProcs"))" > /dev/null
        fi

        (
            cd "$case" || exit 1
            runApplication blockMesh
            runApplication topoSet
            restore0Dir
            runApplication initAlphaField
            touch velocity.foam

            if [ "$nProcs" -gt 1 ]
            then
                runApplication decomposePar
                echo "Running gfmInterFlow on $(pwd) ($nProcs ranks, timeout ${tmax}s)"
                timeout -k 10 "$tmax" \
                    mpirun -np "$nProcs" gfmInterFlow -parallel \
                    > log.gfmInterFlow 2>&1
            else
                echo "Running gfmInterFlow on $(pwd) (timeout ${tmax}s)"
                timeout -k 10 "$tmax" gfmInterFlow > log.gfmInterFlow 2>&1
            fi
            status=$?

            if grep -q "^End" log.gfmInterFlow
            then
                if [ "$status" -ne 0 ]
                then
                    echo "    WARNING: End reached but exit status $status" \
                         "(check the end of log.gfmInterFlow)"
                else
                    echo "    finished OK ($(grep ExecutionTime log.gfmInterFlow | tail -1 | awk '{print $3}') s)"
                fi
            else
                echo "    FAILED (status $status), last lines of the log:" 1>&2
                tail -n 15 log.gfmInterFlow 1>&2
            fi
        )
    done
done
done

python3 ./collect.py
